  ; ===== NET DEFINITIONS =====
  (net 0 "GND")
  (net 1 "+5V")
  (net 2 "GPIO1_LOW_SENSOR")
  (net 3 "GPIO2_HIGH_SENSOR")
  (net 4 "GPIO3_RESERVOIR")
  (net 5 "GPIO4_RELAY_CTRL")
  (net 6 "GPIO5_PUMP_LED")
  (net 7 "GPIO6_ERR_LED")
  (net 8 "PUMP_OUT")
  (net 9 "RELAY_COIL")
  (net 10 "USB_5V_IN")

